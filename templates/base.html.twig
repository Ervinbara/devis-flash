<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DevisFlash - Générateur de devis PDF{% endblock %}</title>

    {{ encore_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}

    <style>
        /* Structure pour footer collé en bas */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1 0 auto;
        }

        .footer {
            flex-shrink: 0;
            margin-top: auto;
        }
    </style>
</head>
<body>
<nav class="navbar">
    <div class="container">
        <a href="{{ path('home') }}" class="logo">⚡ DevisFlash</a>
        <ul class="nav-links">
            <li><a href="{{ path('quote_new') }}">Créer un devis</a></li>
            <li><a href="{{ path('pricing') }}">Tarifs</a></li>
            {% if app.user %}
                <li><a href="{{ path('dashboard') }}">📊 Dashboard</a></li>
                <li><a href="#">👤 {{ app.user.firstName }}</a></li>
                <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
            {% else %}
                <li><a href="{{ path('app_login') }}">Connexion</a></li>
                <li><a href="{{ path('app_register') }}">Inscription</a></li>
            {% endif %}
        </ul>
    </div>
</nav>

<main>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="footer">
    <div class="container">
        <p>&copy; {{ "now"|date("Y") }} DevisFlash - Tous droits réservés</p>
        <ul class="footer-links">
            <li><a href="{{ path('legal_mentions') }}">Mentions légales</a></li>
            <li><a href="{{ path('legal_privacy') }}">Confidentialité</a></li>
            <li><a href="{{ path('legal_cgv') }}">CGV</a></li>
        </ul>
    </div>
</footer>

{{ encore_entry_script_tags('app') }}
{% block javascripts %}{% endblock %}
</body>
</html>
