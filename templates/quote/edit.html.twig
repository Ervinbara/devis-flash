{% extends 'base.html.twig' %}

{% block title %}Modifier le devis {{ quote.quoteNumber }} - DevisFlash{% endblock %}

{% block body %}
    <div class="container form-container">
        <div class="form-header">
            <h1>✏️ Modifier le devis</h1>
            <p class="subtitle">
                Devis <strong>{{ quote.quoteNumber }}</strong> - Créé le {{ quote.createdAt|date('d/m/Y à H:i') }}
            </p>
        </div>

        {% if isEditableFree %}
            <div class="alert alert-success">
                ✅ <strong>Modification gratuite</strong> - Ce devis a moins de 24h
            </div>
        {% else %}
            <div class="alert alert-warning">
                ⚠️ <strong>Modification payante</strong> - Ce devis a plus de 24h, modifier consomme 1 crédit
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'class': 'quote-form', 'id': 'quoteForm', 'enctype': 'multipart/form-data'}}) }}

        {# Section Entreprise #}
        <div class="form-section">
            <h2 class="section-title">🏢 Votre entreprise</h2>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.companyName) }}
                    {{ form_widget(form.companyName) }}
                    {{ form_errors(form.companyName) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.companyContact) }}
                    {{ form_widget(form.companyContact) }}
                    {{ form_errors(form.companyContact) }}
                </div>
                <div class="form-group full-width">
                    {{ form_label(form.companyAddress) }}
                    {{ form_widget(form.companyAddress) }}
                    {{ form_errors(form.companyAddress) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.companyEmail) }}
                    {{ form_widget(form.companyEmail) }}
                    {{ form_errors(form.companyEmail) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.companyPhone) }}
                    {{ form_widget(form.companyPhone) }}
                    {{ form_errors(form.companyPhone) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.companySiret) }}
                    {{ form_widget(form.companySiret) }}
                    {{ form_errors(form.companySiret) }}
                </div>
                <div class="form-group full-width">
                    {{ form_label(form.companyLogo) }}
                    {{ form_widget(form.companyLogo) }}
                    {{ form_errors(form.companyLogo) }}
                    <small class="file-upload-hint">Format JPG ou PNG, max 2Mo. Votre logo apparaîtra dans le header du PDF.</small>
                </div>
            </div>
        </div>

        {# Section Client #}
        <div class="form-section">
            <h2 class="section-title">👤 Votre client</h2>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.clientName) }}
                    {{ form_widget(form.clientName) }}
                    {{ form_errors(form.clientName) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.clientCompany) }}
                    {{ form_widget(form.clientCompany) }}
                    {{ form_errors(form.clientCompany) }}
                </div>
                <div class="form-group full-width">
                    {{ form_label(form.clientAddress) }}
                    {{ form_widget(form.clientAddress) }}
                    {{ form_errors(form.clientAddress) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.clientEmail) }}
                    {{ form_widget(form.clientEmail) }}
                    {{ form_errors(form.clientEmail) }}
                </div>
            </div>
        </div>

        {# Section Devis #}
        <div class="form-section">
            <h2 class="section-title">📋 Informations du devis</h2>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.quoteNumber) }}
                    {{ form_widget(form.quoteNumber) }}
                    {{ form_errors(form.quoteNumber) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.quoteDate) }}
                    {{ form_widget(form.quoteDate) }}
                    {{ form_errors(form.quoteDate) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.quoteValidUntil) }}
                    {{ form_widget(form.quoteValidUntil) }}
                    {{ form_errors(form.quoteValidUntil) }}
                </div>
                <div class="form-group full-width">
                    {{ form_label(form.quoteDescription) }}
                    {{ form_widget(form.quoteDescription) }}
                    {{ form_errors(form.quoteDescription) }}
                </div>
            </div>
        </div>

        {# Section Items - COPIÉ EXACTEMENT DEPUIS new.html.twig #}
        <div class="form-section">
            <h2 class="section-title">📦 Lignes de devis</h2>

            <div id="items-container" data-prototype="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}" data-index="{{ form.items|length }}">
                {% for item in form.items %}
                    <div class="item-row">
                        <div class="item-fields">
                            <div class="form-group item-label">
                                {{ form_widget(item.label) }}
                                {{ form_errors(item.label) }}
                            </div>
                            <div class="form-group item-quantity">
                                {{ form_widget(item.quantity) }}
                                {{ form_errors(item.quantity) }}
                            </div>
                            <div class="form-group item-price">
                                {{ form_widget(item.unitPriceHt) }}
                                {{ form_errors(item.unitPriceHt) }}
                            </div>
                        </div>
                        <button type="button" class="btn-remove-item" onclick="removeItem(this)">🗑️</button>
                    </div>
                {% endfor %}
            </div>

            <button type="button" class="btn-add-item" onclick="addItem()">
                ➕ Ajouter une ligne
            </button>

            <div class="totals-preview" id="totalsPreview">
                <div class="total-line">
                    <span>Total HT :</span>
                    <span id="totalHt">0,00 €</span>
                </div>
                <div class="total-line">
                    <span>TVA (<span id="vatRateDisplay">20</span>%) :</span>
                    <span id="vatAmount">0,00 €</span>
                </div>
                <div class="total-line total-ttc">
                    <span>Total TTC :</span>
                    <span id="totalTtc">0,00 €</span>
                </div>
            </div>
        </div>

        {# Section TVA et conditions #}
        <div class="form-section">
            <h2 class="section-title">💶 TVA et conditions</h2>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.vatRate) }}
                    {{ form_widget(form.vatRate) }}
                    {{ form_errors(form.vatRate) }}
                </div>
                <div class="form-group full-width">
                    {{ form_label(form.paymentTerms) }}
                    {{ form_widget(form.paymentTerms) }}
                    {{ form_errors(form.paymentTerms) }}
                </div>
            </div>
        </div>

        {# Template PDF - AJOUTÉ #}
        <div class="form-section">
            <h2 class="section-title">🎨 Style du PDF</h2>
            {{ form_widget(form.pdfTemplate) }}
            {{ form_errors(form.pdfTemplate) }}
        </div>

        {# Submit #}
        <div class="form-actions">
            <button type="submit" class="btn-primary">
                💾 Enregistrer les modifications
            </button>
            <a href="{{ path('dashboard') }}" class="btn-secondary">
                ❌ Annuler
            </a>
        </div>

        {# Message d'avertissement #}
        <div class="template-warning">
            <div class="warning-icon">⚠️</div>
            <div class="warning-content">
                <strong>Choisissez bien votre template maintenant !</strong>
                <p>
                    {% if app.user and app.user.subscription == 'pack' %}
                        Changer de template après = créer un nouveau devis = <strong>-1 crédit</strong>.
                    {% elseif app.user and app.user.subscription == 'pro' %}
                        Vous avez des devis illimités, changez autant de fois que vous voulez ! ✨
                    {% else %}
                        Changer de template après compte dans votre limite de 2 devis/jour.
                    {% endif %}
                </p>
                <p class="tip">
                    💡 <strong>Astuce :</strong> Utilisez "Dupliquer" depuis le dashboard pour tester différents templates sans consommer de crédit supplémentaire.
                </p>
            </div>
        </div>

        {{ form_end(form) }}
    </div>

    <style>
        .template-warning {
            max-width: 900px;
            margin: 2rem auto;
            padding: 1.5rem;
            background: #FEF3C7;
            border: 2px solid #F59E0B;
            border-radius: 12px;
            display: flex;
            gap: 1rem;
        }

        .warning-icon {
            font-size: 2rem;
            flex-shrink: 0;
        }

        .warning-content {
            flex: 1;
        }

        .warning-content strong {
            color: #92400E;
            font-size: 1.1rem;
        }

        .warning-content p {
            margin: 0.5rem 0;
            color: #78350F;
        }

        .tip {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #FCD34D;
        }

        .subtitle {
            color: #6B7280;
            font-size: 1rem;
            margin-top: 0.5rem;
        }

        .btn-secondary {
            display: inline-block;
            background: #6B7280;
            color: white;
            padding: 0.875rem 2rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s;
            margin-left: 1rem;
        }

        .btn-secondary:hover {
            background: #4B5563;
            transform: translateY(-1px);
        }
    </style>
{% endblock %}

{% block javascripts %}
    {# Le script quote-form.js est chargé via app.js #}
{% endblock %}