{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - DevisFlash{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/dashboard-quotes.css') }}">
{% endblock %}

{% block body %}
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>📊 Tableau de bord</h1>
            <p>Bonjour {{ app.user.firstName }} !</p>
        </div>

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# Statistiques #}
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📄</div>
                <div class="stat-content">
                    <div class="stat-value">{{ stats.totalQuotes }}</div>
                    <div class="stat-label">Devis créés</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">💰</div>
                <div class="stat-content">
                    <div class="stat-value">{{ stats.totalHt|number_format(2, ',', ' ') }} €</div>
                    <div class="stat-label">Total HT</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    {% if app.user.subscription == 'pro' %}
                        ⭐
                    {% elseif app.user.subscription == 'pack' %}
                        💎
                    {% else %}
                        🆓
                    {% endif %}
                </div>
                <div class="stat-content">
                    <div class="stat-value">
                        {% if app.user.subscription == 'pro' %}
                            Pro
                        {% elseif app.user.subscription == 'pack' %}
                            Pack
                        {% else %}
                            Gratuit
                        {% endif %}
                    </div>
                    <div class="stat-label">Abonnement</div>
                </div>
            </div>

            {# Afficher les crédits si pack actif #}
            {% if app.user.subscription == 'pack' and app.user.hasActivePackCredits %}
                <div class="stat-card">
                    <div class="stat-icon">🎟️</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ app.user.packCredits }} / 10</div>
                        <div class="stat-label">Crédits restants</div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Encart d'explication des règles #}
        <div class="dashboard-info-box">
            <h3>ℹ️ Comment modifier vos devis ?</h3>
            <div class="info-rules">
                {% if app.user.subscription == 'pro' %}
                    <div class="info-rule">
                        <div class="info-rule-icon">⭐</div>
                        <div class="info-rule-text">
                            <strong>Abonnement Pro :</strong> Modifiez et dupliquez autant que vous voulez, sans limite !
                        </div>
                    </div>
                {% else %}
                    <div class="info-rule">
                        <div class="info-rule-icon">🟢</div>
                        <div class="info-rule-text">
                            <strong>Moins de 24h :</strong> Modifiez gratuitement vos devis récents
                        </div>
                    </div>
                    <div class="info-rule">
                        <div class="info-rule-icon">🟠</div>
                        <div class="info-rule-text">
                            <strong>Plus de 24h :</strong> Modifier ou dupliquer consomme 1 crédit
                            {% if app.user.subscription == 'free' %}
                                ou compte dans votre limite quotidienne
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                <div class="info-rule">
                    <div class="info-rule-icon">📥</div>
                    <div class="info-rule-text">
                        <strong>Télécharger avec template :</strong> Toujours gratuit, testez tous les styles !
                    </div>
                </div>
            </div>
        </div>

        {# Actions rapides #}
        <div class="quick-actions">
            <a href="{{ path('quote_new') }}" class="btn-primary">
                ➕ Nouveau devis
            </a>
            {% if app.user.subscription != 'pro' %}
                <a href="{{ path('pricing') }}" class="btn-secondary">
                    ⭐ Passer Pro
                </a>
            {% endif %}
        </div>

        {# Liste des devis #}
        <div class="quotes-section">
            <h2>Mes devis</h2>

            {% if quotes|length > 0 %}
                <div class="quotes-list">
                    {% for quote in quotes %}
                        {% set now = date() %}
                        {% set createdAt = quote.createdAt %}
                        {% set hoursSinceCreation = (now.timestamp - createdAt.timestamp) / 3600 %}
                        {% set isEditableFree = hoursSinceCreation < 24 %}
                        {% set isPro = app.user.subscription == 'pro' %}

                        {# Déterminer la classe CSS #}
                        {% if isPro %}
                            {% set cardClass = 'pro-unlimited' %}
                            {% set statusText = 'Modification illimitée' %}
                        {% elseif isEditableFree %}
                            {% set cardClass = 'editable-free' %}
                            {% set statusText = 'Modifiable gratuit' %}
                        {% else %}
                            {% set cardClass = 'editable-paid' %}
                            {% set statusText = 'Modification payante' %}
                        {% endif %}

                        <div class="quote-card {{ cardClass }}">
                            <div class="quote-header">
                                <div class="quote-number">
                                    {% if isPro %}
                                        ⭐
                                    {% elseif isEditableFree %}
                                        🟢
                                    {% else %}
                                        🟠
                                    {% endif %}
                                    {{ quote.quoteNumber }}
                                </div>
                                <div class="quote-status">{{ statusText }}</div>
                            </div>

                            <div class="quote-info">
                                <div class="quote-client">
                                    {{ quote.clientName }}
                                    {% if quote.clientCompany %} - {{ quote.clientCompany }}{% endif %}
                                </div>
                                <div class="quote-amount">{{ quote.totalTtc|number_format(2, ',', ' ') }} € TTC</div>

                                <div class="quote-date">
                                    📅 Créé {{ quote.createdAt|date('d/m/Y à H:i') }}
                                    (il y a {% if hoursSinceCreation < 1 %}moins d'1h{% elseif hoursSinceCreation < 24 %}{{ hoursSinceCreation|round }} heures{% else %}{{ (hoursSinceCreation / 24)|round }} jours{% endif %})

                                    {% if isEditableFree and not isPro %}
                                        <span class="time-remaining">
                                        ⏰ Encore {{ (24 - hoursSinceCreation)|round }}h pour modifier gratuit
                                    </span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="quote-actions">
                                {# Bouton Télécharger avec dropdown #}
                                <div class="btn-download-wrapper" style="position: relative;">
                                    <button class="btn-quote btn-download" onclick="toggleTemplateDropdown({{ quote.id }})">
                                        📥 Télécharger ▼
                                    </button>
                                    <div class="template-dropdown" id="dropdown-{{ quote.id }}">
                                        <a href="{{ path('dashboard_quote_download_template', {id: quote.id, template: 'modern'}) }}" class="template-option {% if quote.pdfTemplate == 'modern' %}active{% endif %}">
                                            🎨 Modern {% if quote.pdfTemplate == 'modern' %}✓{% endif %}
                                        </a>
                                        <a href="{{ path('dashboard_quote_download_template', {id: quote.id, template: 'corporate'}) }}" class="template-option {% if quote.pdfTemplate == 'corporate' %}active{% endif %}">
                                            💼 Corporate {% if quote.pdfTemplate == 'corporate' %}✓{% endif %}
                                        </a>
                                        <a href="{{ path('dashboard_quote_download_template', {id: quote.id, template: 'creative'}) }}" class="template-option {% if quote.pdfTemplate == 'creative' %}active{% endif %}">
                                            🚀 Creative {% if quote.pdfTemplate == 'creative' %}✓{% endif %}
                                        </a>
                                        <a href="{{ path('dashboard_quote_download_template', {id: quote.id, template: 'classic'}) }}" class="template-option {% if quote.pdfTemplate == 'classic' %}active{% endif %}">
                                            📄 Classic {% if quote.pdfTemplate == 'classic' %}✓{% endif %}
                                        </a>
                                        <a href="{{ path('dashboard_quote_download_template', {id: quote.id, template: 'elegant'}) }}" class="template-option {% if quote.pdfTemplate == 'elegant' %}active{% endif %}">
                                            ✨ Elegant {% if quote.pdfTemplate == 'elegant' %}✓{% endif %}
                                        </a>
                                    </div>
                                </div>

                                {# Bouton Modifier #}
                                <a href="{{ path('dashboard_quote_edit', {id: quote.id}) }}" class="btn-quote btn-edit">
                                    ✏️ Modifier
                                    {% if not isPro and not isEditableFree %}
                                        <span class="credit-badge">-1 crédit</span>
                                    {% endif %}
                                </a>

                                {# Bouton Envoyer #}
                                <button class="btn-quote btn-send" onclick="openEmailModal({{ quote.id }})">
                                    📧 Envoyer
                                </button>

                                {# Bouton Dupliquer #}
                                <a href="{{ path('dashboard_quote_duplicate', {id: quote.id}) }}" class="btn-quote btn-duplicate">
                                    📋 Dupliquer
                                    {% if not isPro %}
                                        <span class="credit-badge">-1 crédit</span>
                                    {% endif %}
                                </a>

                                {# Bouton Supprimer #}
                                <form method="post" action="{{ path('dashboard_quote_delete', {id: quote.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce devis ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quote.id) }}">
                                    <button type="submit" class="btn-quote btn-delete">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">📄</div>
                    <h3>Aucun devis pour le moment</h3>
                    <p>Créez votre premier devis pour le voir apparaître ici !</p>
                    <a href="{{ path('quote_new') }}" class="btn-primary">
                        ➕ Créer mon premier devis
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // Toggle dropdown template
        function toggleTemplateDropdown(quoteId) {
            const dropdown = document.getElementById('dropdown-' + quoteId);
            const allDropdowns = document.querySelectorAll('.template-dropdown');

            // Fermer tous les autres dropdowns
            allDropdowns.forEach(d => {
                if (d !== dropdown) {
                    d.classList.remove('active');
                }
            });

            // Toggle le dropdown actuel
            dropdown.classList.toggle('active');
        }

        // Fermer les dropdowns si clic en dehors
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.btn-download-wrapper')) {
                document.querySelectorAll('.template-dropdown').forEach(d => {
                    d.classList.remove('active');
                });
            }
        });

        // Modal email (à implémenter si besoin)
        function openEmailModal(quoteId) {
            // TODO: Implémenter modal email
            alert('Fonctionnalité email en cours de développement');
        }
    </script>
{% endblock %}
